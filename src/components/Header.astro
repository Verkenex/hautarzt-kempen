---
import { practice } from '../data/site';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Hautarztpraxis Kempen – Startseite">
      <img class="brand-logo" src="/assets/mvz-kempen-logo.svg" width="1180" height="312" alt="Hautärztliches MVZ Kempen · CORIUS" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Menü öffnen"><span class="menu-lines" aria-hidden="true"></span></button>
    <nav class="nav" id="main-nav" aria-label="Hauptnavigation">
      <a href="/behandlung/">Leistungen</a>
      <a href="/team/">Ärzteteam</a>
      <a href="/praxis/">Praxis</a>
      <a href="/patienteninformationen/">Patienteninfo</a>
      <a href="/kontakt-termine/">Kontakt</a>
      <a class="button" href={practice.doctolib} target="_blank" rel="noopener noreferrer">Termin buchen</a>
    </nav>
  </div>
</header>
<script is:inline>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('#main-nav');
  if (toggle && nav) toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schließen');
    nav.classList.toggle('is-open', !open);
  });
</script>
