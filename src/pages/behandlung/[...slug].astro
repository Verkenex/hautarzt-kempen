---
import PageLayout from '../../layouts/PageLayout.astro';
import OnlineDoctorCard from '../../components/OnlineDoctorCard.astro';
import { services, practice } from '../../data/site';
import { serviceContent } from '../../data/service-content';
import { getServiceGuidance, canUseOnlineDoctor } from '../../data/service-guidance';

export function getStaticPaths(){
  return services.map(service=>({params:{slug:service.slug},props:{service}}));
}

const { service } = Astro.props;
const content = serviceContent[service.slug];
if (!content) throw new Error(`Missing final content for service: ${service.slug}`);

const guidance = getServiceGuidance(service.category);
const showOnlineDoctor = canUseOnlineDoctor(service.slug);

const related = services
  .filter(item => item.category === service.category && item.slug !== service.slug)
  .slice(0, 6);
---
<PageLayout
  title={service.title}
  description={content.intro}
  eyebrow={service.category}
>
  <Fragment slot="breadcrumb"><a href="/behandlung/">Leistungen</a> / {service.title}</Fragment>

  <section class="section service-page">
    <div class="container content-grid">
      <article class="prose service-prose">
        <p class="lead">{content.intro}</p>

        {content.sections.map(section =>
          <section class="service-section">
            <h2>{section.heading}</h2>
            {section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map(item => <li>{item}</li>)}</ul>}
          </section>
        )}

        {content.note && <div class="notice"><strong>Wichtig:</strong> {content.note}</div>}
        {content.billing && <div class="billing-note"><strong>Kosten:</strong> {content.billing}</div>}

        {guidance && <section class="service-practical">
          <p class="eyebrow">Praktisch für Ihren Termin</p>
          <h2>{guidance.heading}</h2>
          {guidance.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          {guidance.bullets && <ul class="check-list">{guidance.bullets.map(item => <li>{item}</li>)}</ul>}
        </section>}

        {showOnlineDoctor && <OnlineDoctorCard compact={true} title="Erst einmal online zeigen?" />}

        {guidance?.faq?.length > 0 && <section class="service-faq">
          <p class="eyebrow">Häufige Fragen</p>
          <h2>Was Patienten zu diesem Bereich oft wissen möchten</h2>
          <div class="faq-list">
            {guidance.faq.map(item => <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>)}
          </div>
        </section>}

        <section class="service-cta">
          <p class="eyebrow">Termin</p>
          <h2>Sie möchten den Befund abklären lassen?</h2>
          <p>Reguläre Termine können Sie online über Doctolib vereinbaren. Wenn Sie unsicher sind, welche Terminart passt, erreichen Sie die Praxis auch telefonisch.</p>
          <div class="hero-actions">
            <a class="button" href={practice.doctolib} target="_blank" rel="noopener noreferrer">Termin online buchen</a>
            <a class="button ghost" href={practice.phoneHref}>{practice.phoneDisplay}</a>
          </div>
        </section>
      </article>

      <aside>
        <div class="sidebar-card">
          <h3>Hautarztpraxis Kempen</h3>
          <p><strong>{practice.phoneDisplay}</strong><br />{practice.street}<br />{practice.postalCode} {practice.city}</p>
          <p><a class="text-link" href="/kontakt-termine/">Kontakt & Anfahrt</a></p>
          <p><a class="text-link" href="/akutsprechstunde/">Akutsprechstunde</a></p>
          {showOnlineDoctor && <p><a class="text-link" href={practice.onlineDoctor} target="_blank" rel="noopener noreferrer">OnlineDoctor mit Dr. Berkenkamp</a></p>}
        </div>

        {related.length > 0 && <div class="sidebar-related">
          <p class="eyebrow">Weitere Themen</p>
          <nav aria-label={'Weitere Leistungen aus ' + service.category}>
            {related.map(item => <a href={'/behandlung/' + item.slug + '/'}>{item.title}</a>)}
          </nav>
        </div>}
      </aside>
    </div>
  </section>
</PageLayout>
