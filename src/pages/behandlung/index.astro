---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { services, serviceAreas } from '../../data/site';

const categoryMap = {
  'Dermatologie': 'Dermatologie',
  'Allergologie': 'Allergologie',
  'Phlebologie': 'Phlebologie',
  'Proktologie': 'Proktologie',
  'Ästhetische Dermatologie': 'Ästhetische Dermatologie'
};

const areaServices = (name: string, href: string) => services.filter(service => service.category === categoryMap[name as keyof typeof categoryMap] && '/behandlung/' + service.slug + '/' !== href);
const hrefForTitle = (title: string) => {
  const service = services.find(item => item.title === title);
  return service ? '/behandlung/' + service.slug + '/' : '/behandlung/';
};
---
<PageLayout title="Leistungen" description="Dermatologie, Allergologie, Phlebologie, Proktologie und ästhetische Dermatologie in der Hautarztpraxis Kempen." eyebrow="Behandlung">
<section class="section service-directory">
  <div class="container">
    <div class="directory-intro">
      <p class="eyebrow">Orientierung</p>
      <h2>Unsere Fachbereiche</h2>
      <p class="lead">Von klassischer Dermatologie und Hautkrebsvorsorge über Allergologie, Venen- und Enddarmerkrankungen bis zur ästhetischen Dermatologie: Hier finden Sie die Bereiche, die wir in Kempen behandeln. Häufig gesuchte Themen sind direkt verlinkt; die vollständige Übersicht folgt darunter.</p>
    </div>

    <div class="area-grid">
      {serviceAreas.map((area, index) =>
        <article class={'area-card' + (area.name === 'Ästhetische Dermatologie' ? ' area-card--accent' : '')}>
          <span class="area-number">0{index + 1}</span>
          <h3><a href={area.href}>{area.name}</a></h3>
          <p>{area.description}</p>
          <nav class="area-highlights" aria-label={'Häufige Themen in ' + area.name}>
            {area.highlights.map(item => <a href={hrefForTitle(item)}>{item}</a>)}
          </nav>
          <a class="text-link" href={area.href}>Zum Fachbereich</a>
        </article>
      )}
    </div>

    <div class="all-services">
      <div class="section-heading compact">
        <div><p class="eyebrow">Vollständige Übersicht</p><h2>Alle Leistungen von A bis Z innerhalb der Fachbereiche.</h2></div>
      </div>
      <div class="service-accordions">
        {serviceAreas.map(area => {
          const items = areaServices(area.name, area.href);
          return <details class="service-accordion">
            <summary><span>{area.name}</span><small>{items.length} Themen</small></summary>
            <div class="accordion-content">
              <p>{area.description}</p>
              <div class="link-list">{items.map(service => <a href={'/behandlung/' + service.slug + '/'}>{service.title}</a>)}</div>
            </div>
          </details>
        })}
      </div>
    </div>
  </div>
</section>
<ContactBand />
</PageLayout>
