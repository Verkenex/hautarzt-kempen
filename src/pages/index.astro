---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBand from '../components/ContactBand.astro';
import { practice, doctors } from '../data/site';

const services = [
  ['Allgemeine Dermatologie','Diagnostik und Behandlung von Erkrankungen der Haut, Haare und Nägel.','/behandlung/dermatologie/'],
  ['Hautkrebsvorsorge','Früherkennung und differenzierte Beurteilung auffälliger Hautveränderungen.','/behandlung/dermatologie/hautkrebsvorsorge/'],
  ['Operative Dermatologie','Ambulante dermatologische Eingriffe mit langjähriger operativer Erfahrung.','/behandlung/dermatologie/operative-dermatologie/'],
  ['Ästhetische Dermatologie','Ärztlich verantwortete ästhetische Behandlungen mit dermatologischem Anspruch.','/behandlung/aesthetische-dermatologie/']
];

const actions = [
  ['01','Online-Termin','Termin direkt über Doctolib buchen.',practice.doctolib,true],
  ['02','Akutsprechstunde','Informationen bei akuten Hautproblemen.','/akutsprechstunde/',false],
  ['03','Digitale Anmeldung','Patientendaten vor dem Praxisbesuch ausfüllen.',practice.digitalRegistration,true],
  ['04','Kontakt & Anfahrt','Telefon, Praxiszeiten und Wegbeschreibung.','/kontakt-termine/',false]
];

const aesthetics = [
  ['Faltenbehandlung','/behandlung/aesthetische-dermatologie/faltenbehandlung/'],
  ['Laser-Haarentfernung','/behandlung/aesthetische-dermatologie/laser-haarentfernung/'],
  ['Medizinische Kosmetik','/behandlung/aesthetische-dermatologie/medizinische-kosmetik/'],
  ['Skinbooster','/behandlung/aesthetische-dermatologie/skinbooster/']
];

const leadDoctor = doctors[0];
---
<BaseLayout title="Hautarzt Kempen | MVZ Corius Kempen GmbH" description="Hautarztpraxis in Kempen: Dermatologie, Hautkrebsvorsorge, ambulante Operationen, Allergologie, Phlebologie, Proktologie und ästhetische Dermatologie.">
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Hautarztpraxis Kempen · seit 1994</p>
      <h1>Moderne Dermatologie in Kempen.</h1>
      <p class="lead">Medizinisch fundierte Dermatologie, persönliche Betreuung und kurze Wege – unter der ärztlichen Leitung von Dr. med. Klaus Gerecht.</p>
      <div class="hero-actions">
        <a class="button" href={practice.doctolib} target="_blank" rel="noopener noreferrer">Termin buchen</a>
        <a class="button ghost" href="/behandlung/">Unsere Leistungen</a>
      </div>
      <div class="hero-trust" aria-label="Praxismerkmale">
        <span>Seit 1994 in Kempen</span>
        <span>Ärztliche Leitung Dr. Gerecht</span>
        <span>Online-Termine</span>
      </div>
    </div>
    <figure class="hero-portrait">
      {leadDoctor.image && <img src={leadDoctor.image} width="900" height="1100" alt={leadDoctor.imageAlt} fetchpriority="high" />}
      <figcaption class="hero-caption">
        <p class="eyebrow">Ärztliche Leitung</p>
        <h2>Dr. med. Klaus Gerecht</h2>
        <p>Facharzt für Haut- und Geschlechtskrankheiten · Phlebologie · Proktologie</p>
      </figcaption>
    </figure>
  </div>
</section>

<div class="container quick-wrap">
  <div class="quick-grid">
    {actions.map(([n,title,text,href,external]) =>
      <a class="quick" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
        <span class="quick-number">{n}</span><strong>{title}</strong><span>{text}</span>
      </a>
    )}
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div><p class="eyebrow">Unsere Leistungen</p><h2>Für gesunde Haut – medizinisch fundiert und persönlich.</h2></div>
      <a class="text-link" href="/behandlung/">Alle Leistungen</a>
    </div>
    <div class="service-grid">
      {services.map(([title,text,href],i) =>
        <a class="service-card" href={href}><span class="index">0{i+1}</span><h3>{title}</h3><p>{text}</p><span class="text-link">Mehr erfahren</span></a>
      )}
    </div>
  </div>
</section>

<section class="aesthetic-band section">
  <div class="container aesthetic-grid">
    <div>
      <p class="eyebrow">Ästhetische Dermatologie</p>
      <h2>Ästhetik mit dermatologischem Blick.</h2>
      <p class="lead">Ästhetische Behandlungen werden bei uns nicht losgelöst von der Hautmedizin gedacht. Im Mittelpunkt stehen eine ärztliche Einschätzung, realistische Ziele und ein Ergebnis, das zur Person passt.</p>
    </div>
    <nav class="aesthetic-links" aria-label="Ästhetische Leistungen">
      {aesthetics.map(([title,href]) => <a href={href}>{title} →</a>)}
    </nav>
  </div>
</section>

<section class="leadership section">
  <div class="container leadership-grid">
    <div class="leadership-mark" aria-hidden="true"><strong>1994</strong><span>Gründung der Hautarztpraxis Dr. Gerecht in Kempen.</span></div>
    <div>
      <p class="eyebrow">Ärztliche Leitung</p>
      <h2>Erfahrung, die mit dem Standort gewachsen ist.</h2>
      <p class="lead">Dr. med. Klaus Gerecht gründete seine Hautarztpraxis 1994 in Kempen. Heute leitet er das Ärzteteam der MVZ Corius Kempen GmbH und steht weiterhin persönlich für die medizinische Ausrichtung des Standortes.</p>
      <div class="fact-row">
        <div><strong>Dermatologie</strong><span>Haut- und Geschlechtskrankheiten</span></div>
        <div><strong>Zusatzgebiete</strong><span>Phlebologie · Proktologie</span></div>
      </div>
      <a class="text-link" href="/team/dr-med-klaus-gerecht/">Dr. Gerecht kennenlernen</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div><p class="eyebrow">Ärzteteam</p><h2>Fachliche Expertise. Persönliche Betreuung.</h2></div>
      <a class="text-link" href="/team/">Zum Ärzteteam</a>
    </div>
    <div class="doctor-grid">
      {doctors.map(d =>
        <article class="doctor-card">
          <div class="doctor-media">
            {d.image ? <img src={d.image} width="640" height="760" alt={d.imageAlt} loading="lazy" /> : <div class="doctor-monogram" aria-label={'Foto von ' + d.name + ' folgt'}>{d.initials}</div>}
          </div>
          <div class="doctor-body"><p class="role">{d.role}</p><h3>{d.name}</h3><p>{d.details}</p>{d.href && <a class="text-link" href={d.href}>Profil</a>}</div>
        </article>
      )}
    </div>
  </div>
</section>

<ContactBand />
</BaseLayout>
