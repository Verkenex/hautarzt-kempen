---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBand from '../components/ContactBand.astro';
import OnlineDoctorCard from '../components/OnlineDoctorCard.astro';
import { practice, doctors, serviceAreas } from '../data/site';

const actions = [
  ['01','Online-Termin','Termin direkt über Doctolib buchen.',practice.doctolib,true],
  ['02','Akutsprechstunde','Informationen bei akuten Hautproblemen.','/akutsprechstunde/',false],
  ['03','Digitale Anmeldung','Patientendaten vor dem Praxisbesuch ausfüllen.',practice.digitalRegistration,true],
  ['04','Kontakt & Anfahrt','Telefon, Praxiszeiten und Wegbeschreibung.','/kontakt-termine/',false]
];

const aesthetics = [
  ['Faltenbehandlung','/behandlung/aesthetische-dermatologie/faltenbehandlung/'],
  ['Laser-Haarentfernung','/behandlung/aesthetische-dermatologie/laser-haarentfernung/'],
  ['Medizinische Kosmetik','/behandlung/aesthetische-dermatologie/medizinische-kosmetik/'],
  ['Skinbooster','/behandlung/aesthetische-dermatologie/skinbooster/']
];

const leadDoctor = doctors[0];
const dermatology = serviceAreas[0];
const aestheticArea = serviceAreas[4];
const specialties = serviceAreas.slice(1,4);

const reviewVoices = [
  { quote: 'Hier lohnt jede Minute Wartezeit.', meta: 'Google-Bewertung · Juni 2026' },
  { quote: 'ganz für den Patienten da', meta: 'Google-Bewertung · Juli 2026' },
  { quote: 'Professionelles, kompetentes und freundliches Praxisteam.', meta: 'Google-Bewertung · Juni 2026' }
];
---
<BaseLayout title="Hautarzt Kempen | MVZ Corius Kempen GmbH" description="Hautarztpraxis in Kempen: Dermatologie, Hautkrebsvorsorge, ambulante Operationen, Allergologie, Phlebologie, Proktologie und ästhetische Dermatologie.">
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Hautarztpraxis Kempen · seit 1994</p>
      <h1>Moderne Dermatologie in Kempen.</h1>
      <p class="lead">Dr. Klaus Gerecht ist seit 1994 als Hautarzt in Kempen tätig. Heute behandelt er hier gemeinsam mit seinem Ärzteteam – von der klassischen Dermatologie und Hautkrebsvorsorge bis zu Operationen, Venenheilkunde und ästhetischen Behandlungen.</p>
      <div class="hero-actions">
        <a class="button" href={practice.doctolib} target="_blank" rel="noopener noreferrer">Termin buchen</a>
        <a class="button ghost" href="/behandlung/">Unsere Leistungen</a>
      </div>
      <div class="hero-trust" aria-label="Praxismerkmale">
        <span>Seit 1994 in Kempen</span>
        <span>Ärztliche Leitung Dr. Gerecht</span>
        <span>Online-Termine</span>
      </div>
    </div>
    <figure class="hero-portrait">
      {leadDoctor.image && <img src={leadDoctor.image} width="900" height="1100" alt={leadDoctor.imageAlt} style={'object-position:' + leadDoctor.imagePosition} fetchpriority="high" />}
      <figcaption class="hero-caption">
        <p class="eyebrow">Ärztliche Leitung</p>
        <h2>Dr. med. Klaus Gerecht</h2>
        <p>Facharzt für Haut- und Geschlechtskrankheiten · Phlebologie · Proktologie</p>
      </figcaption>
    </figure>
  </div>
</section>

<div class="container quick-wrap">
  <div class="quick-grid">
    {actions.map(([n,title,text,href,external]) =>
      <a class="quick" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
        <span class="quick-number">{n}</span><strong>{title}</strong><span>{text}</span>
      </a>
    )}
  </div>
</div>

<section class="section online-doctor-home">
  <div class="container"><OnlineDoctorCard title="Hautproblem? Dr. Berkenkamp schaut auch online darauf." /></div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div><p class="eyebrow">Unsere Leistungen</p><h2>Unsere Fachbereiche.</h2></div>
      <a class="text-link" href="/behandlung/">Alle Leistungen im Detail</a>
    </div>
    <div class="home-service-grid">
      <a class="home-service-feature" href={dermatology.href}>
        <span class="service-kicker">Medizinische Dermatologie</span>
        <h3>{dermatology.name}</h3>
        <p>{dermatology.description}</p>
        <div class="service-tags">{dermatology.highlights.map(item => <span>{item}</span>)}</div>
        <span class="text-link">Dermatologie entdecken</span>
      </a>
      <a class="home-service-feature home-service-feature--accent" href={aestheticArea.href}>
        <span class="service-kicker">Ästhetik & Kosmetik</span>
        <h3>{aestheticArea.name}</h3>
        <p>{aestheticArea.description}</p>
        <div class="service-tags">{aestheticArea.highlights.map(item => <span>{item}</span>)}</div>
        <span class="text-link">Ästhetische Leistungen</span>
      </a>
    </div>
    <div class="specialty-strip" aria-label="Weitere Fachbereiche">
      {specialties.map(area =>
        <a href={area.href}><span>{area.name}</span><small>{area.description}</small><strong aria-hidden="true">→</strong></a>
      )}
    </div>
  </div>
</section>

<section class="aesthetic-band section">
  <div class="container aesthetic-grid">
    <div>
      <p class="eyebrow">Ästhetische Dermatologie</p>
      <h2>Ästhetik gehört bei uns zur Dermatologie.</h2>
      <p class="lead">Wenn Sie wegen Falten, Pigmenten, Narben oder sichtbaren Gefäßen zu uns kommen, schauen wir zuerst auf die Haut und auf das, was Sie tatsächlich stört. Danach besprechen wir, was sich sinnvoll verändern lässt – und auch, wann wir von einer Behandlung abraten.</p>
    </div>
    <nav class="aesthetic-links" aria-label="Ästhetische Leistungen">
      {aesthetics.map(([title,href]) => <a href={href}>{title} →</a>)}
    </nav>
  </div>
</section>

<section class="leadership section">
  <div class="container leadership-grid">
    <div class="leadership-mark" aria-hidden="true"><strong>1994</strong><span>Beginn der dermatologischen Gemeinschaftspraxis in Kempen.</span></div>
    <div>
      <p class="eyebrow">Ärztliche Leitung</p>
      <h2>Seit mehr als 30 Jahren Hautarzt in Kempen.</h2>
      <p class="lead">Dr. Klaus Gerecht ließ sich 1994 als Hautarzt in Kempen nieder. Viele Patientinnen und Patienten kennt er seit Jahren oder inzwischen über mehrere Generationen. Heute arbeitet er gemeinsam mit Dr. Moritz Berkenkamp und zwei Ärzten in Weiterbildung in der Hautarztpraxis an der St. Huberter Straße.</p>
      <div class="fact-row">
        <div><strong>Dermatologie</strong><span>Haut- und Geschlechtskrankheiten</span></div>
        <div><strong>Zusatzgebiete</strong><span>Phlebologie · Proktologie</span></div>
      </div>
      <a class="text-link" href="/team/dr-med-klaus-gerecht/">Dr. Gerecht kennenlernen</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div><p class="eyebrow">Ärzteteam</p><h2>Die Ärzte, die Sie bei uns behandeln.</h2></div>
      <a class="text-link" href="/team/">Zum Ärzteteam</a>
    </div>
    <div class="doctor-grid">
      {doctors.map(d =>
        <article class="doctor-card">
          <div class="doctor-media">
            {d.image
              ? <img src={d.image} width="640" height="800" alt={d.imageAlt} style={'object-position:' + d.imagePosition} loading="lazy" />
              : <div class="doctor-monogram" aria-label={'Foto von ' + d.name + ' folgt'}><span>{d.initials}</span><small>Foto folgt</small></div>}
          </div>
          <div class="doctor-body"><p class="role">{d.role}</p><h3>{d.name}</h3><p>{d.details}</p>{d.href && <a class="text-link" href={d.href}>Profil</a>}</div>
        </article>
      )}
    </div>
  </div>
</section>

<section class="reviews-section section" aria-labelledby="reviews-title">
  <div class="container">
    <div class="reviews-heading">
      <p class="eyebrow">Patientenerfahrungen</p>
      <h2 id="reviews-title">Was Patienten besonders hervorheben.</h2>
    </div>
    <div class="review-grid">
      {reviewVoices.map((review, index) =>
        <figure class:list={['review-quote', index === 0 && 'review-quote--feature']}>
          <blockquote>„{review.quote}“</blockquote>
          <figcaption>{review.meta}</figcaption>
        </figure>
      )}
    </div>
  </div>
</section>

<ContactBand />
</BaseLayout>
