---
import PageLayout from '../../layouts/PageLayout.astro';
import { practice, doctors } from '../../data/site';
const doctor = doctors[0];

const academic = [
  ['06/1979', 'Abitur am Friedrich-Ebert-Gymnasium in Bonn'],
  ['1979–1986', 'Studium der Humanmedizin an der Rheinischen Friedrich-Wilhelms-Universität Bonn'],
  ['Frühjahr 1986', 'Ärztliche Prüfung in Siegen; anschließend ECFMG-Prüfung'],
  ['Sommer 1989', 'Promotion zum Dr. med. mit summa cum laude; Dissertation zu biochemischen und physiologischen Veränderungen bei Segelflugpiloten']
];

const stations = [
  ['1980–1985', 'Krankenpflegepraktikum und klinische Ausbildungsstationen in Bonn, Washington D.C., Nottingham, London und Hiranpur/Indien'],
  ['1985–1986', 'Praktisches Jahr in Dermatologie und Chirurgie am Bethesda Krankenhaus Freudenberg sowie Innerer Medizin am Jung-Stilling-Krankenhaus Siegen'],
  ['07/1986–07/1987', 'Senior House Surgeon am Waikato Hospital in Hamilton, Neuseeland – Onkologie, Allgemeinchirurgie, HNO/Augenheilkunde und Notaufnahme'],
  ['07–08/1987', 'Geburtshilfe und Gynäkologie am Tokoroa Hospital, Neuseeland'],
  ['01–03/1988', 'Hausarztvertretung in Meckenheim'],
  ['04/1988–12/1989', 'Chirurgie am Hospital zum Heiligen Geist in Kempen'],
  ['01/1990–12/1991', 'Wissenschaftlicher Mitarbeiter an der Hautklinik der Universität Essen; Schwerpunkte operative Dermatologie, Phlebologie, Proktologie und HIV'],
  ['02/1992 – 05/1994', 'Wissenschaftlicher Mitarbeiter an der Hautklinik der Universität zu Köln; Poliklinik, Phlebologie, operative Dermatologie und Allergologie'],
  ['04/1994', 'Facharztprüfung für Haut- und Geschlechtskrankheiten in Düsseldorf'],
  ['08/1994', 'Niederlassung als Hautarzt in Kempen; Gemeinschaftspraxis mit Dr. med. Birgit Merdausl, Hülser Straße 10'],
  ['2004', 'Umzug der Gemeinschaftspraxis in die St. Huberter Straße 25 in Kempen'],
  ['02.01.2008', 'Ausscheiden von Dr. med. Birgit Merdausl; Weiterführung der Praxis durch Dr. Gerecht'],
  ['seit 1994', 'Dermatologische Tätigkeit in eigener Niederlassung beziehungsweise am heutigen MVZ-Standort in Kempen']
];

const flying = [
  ['1980–1983', 'Segelflug, Akaflieg Universität Bonn'],
  ['1987 / 1988', 'PPL Neuseeland / PPL Deutschland'],
  ['1990 / 1991', 'Nachtflugberechtigung / CFVR'],
  ['1999 / 2000', 'IFR / CPL'],
  ['2005', 'MEP / IR'],
  ['2014', 'HPA, SET'],
  ['2024', 'Spornrad']
];
---
<PageLayout title="Dr. med. Klaus Gerecht" description="Dr. med. Klaus Gerecht ist Ärztlicher Leiter der MVZ Corius Kempen GmbH und seit 1994 als Hautarzt in Kempen tätig." eyebrow="Ärztliche Leitung">
  <Fragment slot="breadcrumb"><a href="/team/">Ärzteteam</a> / Dr. med. Klaus Gerecht</Fragment>

  <section class="section doctor-profile">
    <div class="container profile-intro">
      <div class="profile-photo">
        {doctor.image && <img src={doctor.image} width="900" height="900" alt={doctor.imageAlt} />}
      </div>
      <div>
        <p class="eyebrow">Seit 1994 in Kempen</p>
        <h2>Dr. med. Klaus Gerecht</h2>
        <p class="lead">Facharzt für Haut- und Geschlechtskrankheiten mit den Zusatzbezeichnungen Phlebologie und Proktologie. Dr. Gerecht ließ sich 1994 als Hautarzt in Kempen nieder und leitet heute das Ärzteteam der MVZ Corius Kempen GmbH.</p>
        <p>Sein beruflicher Weg führte ihn vor der Niederlassung durch Krankenhäuser und Universitätskliniken in Deutschland, Großbritannien, Indien, den USA und Neuseeland. Operative Dermatologie, Phlebologie und Proktologie gehören seit vielen Jahren zu seinen besonderen Arbeitsgebieten.</p>
        <a class="button" href={practice.doctolib} target="_blank" rel="noopener noreferrer">Termin buchen</a>
      </div>
    </div>
  </section>

  <section class="profile-vita section">
    <div class="narrow">
      <p class="eyebrow">Vita</p>
      <h2>Ausbildung und beruflicher Weg</h2>

      <h3>Akademische Laufbahn</h3>
      <div class="vita-list">{academic.map(([date,text]) => <div class="vita-row"><time>{date}</time><p>{text}</p></div>)}</div>

      <h3>Ausbildung und ärztliche Stationen</h3>
      <div class="vita-list">{stations.map(([date,text]) => <div class="vita-row"><time>{date}</time><p>{text}</p></div>)}</div>

      <h3>Fliegerei</h3>
      <p>Das Fliegen begleitet Dr. Gerecht seit dem Studium. Zu seinem fliegerischen Werdegang gehören:</p>
      <div class="vita-list">{flying.map(([date,text]) => <div class="vita-row"><time>{date}</time><p>{text}</p></div>)}</div>
      <p class="muted">Aktuell geflogene Muster: P46T Jetprop, Sportavia Pützer RS180, Twin Bonanza, YAK 52 und Pilatus P2.</p>
    </div>
  </section>
</PageLayout>
