---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { doctors } from '../../data/site';
---
<PageLayout title="Ärzteteam" description="Das Ärzteteam der MVZ Corius Kempen GmbH unter der ärztlichen Leitung von Dr. med. Klaus Gerecht." eyebrow="Team">
  <section class="section">
    <div class="container">
      <div class="team-intro">
        <p class="lead">Unser Ärzteteam verbindet langjährige fachärztliche Erfahrung mit Weiterbildung am Standort. Dr. med. Klaus Gerecht verantwortet die ärztliche Leitung.</p>
      </div>
      <div class="doctor-grid">
        {doctors.map(d =>
          <article class="doctor-card">
            <div class="doctor-media">
              {d.image ? <img src={d.image} width="640" height="760" alt={d.imageAlt} loading="lazy" /> : <div class="doctor-monogram" aria-label={'Foto von ' + d.name + ' folgt'}>{d.initials}</div>}
            </div>
            <div class="doctor-body"><p class="role">{d.role}</p><h3>{d.name}</h3><p>{d.details}</p>{d.href && <a class="text-link" href={d.href}>Vita</a>}</div>
          </article>
        )}
      </div>
    </div>
  </section>
  <ContactBand />
</PageLayout>
