---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { doctors } from '../../data/site';
---
<PageLayout title="Ärzteteam" description="Das ärztliche Team des Hautärztlichen MVZ Kempen um den Ärztlichen Leiter Dr. med. Klaus Gerecht." eyebrow="Team">
<section class="section"><div class="container"><div class="doctor-grid">{doctors.map(d => <article class="doctor-card"><p class="role">{d.role}</p><h3>{d.name}</h3><p>{d.details}</p>{d.href&&<a class="text-link" href={d.href}>Vita</a>}</article>)}</div></div></section><ContactBand />
</PageLayout>
