---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { doctors } from '../../data/site';
---
<PageLayout title="Ärzteteam" description="Das Ärzteteam der MVZ Corius Kempen GmbH unter der ärztlichen Leitung von Dr. med. Klaus Gerecht." eyebrow="Team">
  <section class="section">
    <div class="container">
      <div class="team-intro">
        <p class="lead">Dr. Klaus Gerecht arbeitet seit 1994 als Hautarzt in Kempen. Heute besteht das Ärzteteam aus ihm, Dr. Moritz Berkenkamp sowie Dr. Avgousta Hadjisoteriou und Orhan Emre Avsar in Weiterbildung.</p>
      </div>
      <div class="doctor-grid">
        {doctors.map(d =>
          <article class="doctor-card">
            <div class="doctor-media">
              {d.image
                ? <img src={d.image} width="640" height="800" alt={d.imageAlt} style={'object-position:' + d.imagePosition} loading="lazy" />
                : <div class="doctor-monogram" aria-label={'Foto von ' + d.name + ' folgt'}><span>{d.initials}</span><small>Foto folgt</small></div>}
            </div>
            <div class="doctor-body"><p class="role">{d.role}</p><h3>{d.name}</h3><p>{d.details}</p>{d.href&&<a class="text-link" href={d.href}>Vita</a>}</div>
          </article>
        )}
      </div>
    </div>
  </section>
  <ContactBand />
</PageLayout>
